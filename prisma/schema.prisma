// =============================================================
// KINCLONGIN POS WASH — PRISMA SCHEMA FILE (MySQL on SumoPod)
// =============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  SUPERADMIN
  OWNER
  MANAGER
  CASHIER
  WASHER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VehicleCategory {
  MOTOR_KECIL // Bebek, Matic 110-125cc (Beat, Vario, Mio)
  MOTOR_BESAR // NMax, PCX, Vespa, 150-250cc
  MOTOR_MOGE // 250cc+, Harley, Trail
  MOBIL_KECIL // Brio, Agya, Yaris, Hatchback
  MOBIL_SEDANG // Avanza, Xpander, HR-V, Sedan
  MOBIL_BESAR // Pajero, Fortuner, Alphard, Double Cabin
  KENDARAAN_LAIN // Pick-up, Truk Engkel
}

enum TicketStatus {
  QUEUED // Menunggu slot/bay cuci
  WASHING // Di area basah / hidrolik
  DRYING // Pengeringan, lap semir ban, vakum
  READY // Selesai QC, siap diserahkan/diambil
  COMPLETED // Pembayaran lunas & kendaraan telah keluar
  CANCELLED // Dibatalkan (dengan audit log)
}

enum PaymentMethod {
  CASH
  QRIS
  BANK_TRANSFER
  SPLIT
  LOYALTY_POINTS
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum CommissionType {
  PERCENTAGE // Persentase dari harga paket (contoh: 30%)
  FIXED_NOMINAL // Nominal flat (contoh: Rp 10.000 / kendaraan)
}

enum MovementType {
  IN_RESTOCK // Pembelian/penambahan stok baru
  OUT_USAGE // Pemakaian bahan habis pakai
  OUT_SALE // Terjual via POS Kasir
  ADJUSTMENT_OPNAME // Penyesuaian fisik opname
}

enum CashMovementType {
  PAID_IN // Kas Masuk (modal tambahan, titipan, dll.)
  PAID_OUT // Kas Keluar operasional (beli es, galon, bensin, setor bank)
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum TaxType {
  INCLUSIVE
  EXCLUSIVE
}

enum SurchargeBearer {
  OUTLET
  CUSTOMER
}

enum WhatsAppDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  TRIAL
}

enum SubscriptionPaymentMethod {
  MANUAL_TRANSFER
  QRIS
}

enum SubscriptionPaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// -------------------------------------------------------------
// 1. OUTLET / CABANG & PENGGUNA
// -------------------------------------------------------------

model Outlet {
  id              String  @id @default(cuid())
  name            String // Contoh: "Kinclongin Cabang Mataram"
  slug            String  @unique // Slug URL identitas cabang
  address         String  @db.Text
  phone           String
  logoUrl         String?
  waGatewayApiKey String? // Kunci API untuk WhatsApp Gateway
  waSenderNumber  String? // Nomor WhatsApp pengirim notifikasi
  isActive        Boolean @default(true)
  ownerId         String? // User ID pemilik cabang (Owner)
  slogan          String? // Slogan usaha kustom (misal: "Cepat, Bersih & Berkilau")
  receiptHeader   String? // Teks kustom kepala nota struk
  receiptFooter   String? // Teks kustom catatan kaki nota struk
  contactPhone    String? // Nomor kontak CS / WhatsApp bantuan
  subscriptionExpiresAt DateTime?
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)

  // Konfigurasi Pajak (PB1) & MDR QRIS
  taxEnabled          Boolean         @default(false)
  taxRate             Decimal         @default(10.0) @db.Decimal(5, 2)
  taxType             TaxType         @default(EXCLUSIVE)
  taxLabel            String          @default("PB1")
  qrisSurchargeBearer SurchargeBearer @default(OUTLET)
  qrisSurchargeRate   Decimal         @default(0.7) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi
  owner                User?                       @relation("OwnedOutlets", fields: [ownerId], references: [id], onDelete: SetNull)
  users                User[]                      @relation("OutletUsers")
  employees            Employee[]
  servicePackages      ServicePackage[]
  washTickets          WashTicket[]
  retailProducts       RetailProduct[]
  operationalSupplies  OperationalSupply[]
  stockMovements       StockMovement[]
  payments             Payment[]
  customerMemberships  CustomerMembership[]
  auditLogs            AuditLog[]
  workShifts           WorkShift[]
  shiftAssignments     ShiftAssignment[]
  subscriptionPayments TenantSubscriptionPayment[]
  cashMovements        CashMovement[]
  promotions           PromotionRule[]
  washClubSubscriptions WashClubSubscription[]

  @@index([ownerId])
  @@index([isActive])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String? // Hash password bcryptjs untuk kredensial login Auth.js
  fullName     String
  avatarUrl    String?
  role         UserRole   @default(CASHIER)
  status       UserStatus @default(ACTIVE)
  outletId     String?
  pinCode      String? // 4-6 digit PIN terenkripsi untuk supervisor override & terminal
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relasi
  outlet          Outlet?      @relation("OutletUsers", fields: [outletId], references: [id], onDelete: SetNull)
  ownedOutlets    Outlet[]     @relation("OwnedOutlets")
  employee        Employee?
  createdTickets  WashTicket[] @relation("TicketCreator")
  handledPayments            Payment[]            @relation("CashierPayments")
  handledCustomerMemberships CustomerMembership[] @relation("CashierMemberships")
  auditLogs                  AuditLog[]           @relation("ActorAuditLogs")
  cashMovements              CashMovement[]       @relation("CashierCashMovements")
  authorizedVoids            WashTicket[]         @relation("VoidAuthorizer")

  @@index([role])
  @@index([outletId])
  @@index([status])
}

model Employee {
  id             String         @id @default(cuid())
  outletId       String
  userId         String?        @unique // Jika pekerja memiliki akun login Kinclongin (opsional)
  fullName       String
  phone          String?
  pinCode        String? // 4-digit PIN terenkripsi untuk login Kiosk Tablet
  role           UserRole       @default(WASHER)
  commissionType CommissionType @default(FIXED_NOMINAL)
  commissionRate Decimal        @default(10000) @db.Decimal(10, 2)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relasi
  outlet          Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedTickets  TicketWasher[]
  shiftAssignments ShiftAssignment[]

  @@index([outletId])
  @@index([role, isActive])
}

// -------------------------------------------------------------
// 2. PELANGGAN & KENDARAAN (MEMBERSHIP)
// -------------------------------------------------------------

model Customer {
  id            String   @id @default(cuid())
  phone         String   @unique // Nomor WhatsApp sebagai primary key bisnis
  fullName      String
  notes         String?
  loyaltyPoints Int      @default(0)
  totalVisits   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relasi
  vehicles              Vehicle[]
  washTickets           WashTicket[]
  memberships           CustomerMembership[]
  loyaltyLogs           CustomerLoyaltyLog[]
  washClubSubscriptions WashClubSubscription[]

  @@index([phone])
}

model Vehicle {
  id           String          @id @default(cuid())
  licensePlate String          @unique // Contoh: "DR 1234 AB" (uppercase tanpa spasi berlebih)
  category     VehicleCategory
  brand        String? // Honda, Toyota, Yamaha, dll.
  model        String? // Avanza, Vario 160, Fortuner
  color        String? // Hitam, Putih, dll.
  customerId   String?
  totalVisits  Int             @default(0) // Akumulasi kunjungan khusus plat nomor ini untuk validasi promo Cuci 10x Gratis 1x
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Relasi
  customer              Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  washTickets           WashTicket[]
  washClubSubscriptions WashClubSubscription[]

  @@index([licensePlate])
  @@index([category])
}

// -------------------------------------------------------------
// 3. MASTER PAKET LAYANAN CUCI
// -------------------------------------------------------------

model ServicePackage {
  id                String          @id @default(cuid())
  outletId          String
  name              String // Contoh: "Cuci Salju + Semir Ban"
  description       String?
  vehicleCategory   VehicleCategory
  price             Decimal         @db.Decimal(10, 2)
  estimatedMinutes  Int             @default(30)
  defaultCommission Decimal         @default(10000) @db.Decimal(10, 2)
  commissionType    CommissionType  @default(FIXED_NOMINAL)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relasi
  outlet      Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  washTickets WashTicket[]
  recipeItems ServiceRecipeItem[]

  @@index([outletId, vehicleCategory, isActive])
}

// -------------------------------------------------------------
// 4. TRANSAKSI TIKET CUCI & ANTREAN (KANBAN)
// -------------------------------------------------------------

model WashTicket {
  id               String          @id @default(cuid())
  ticketNumber     String          @unique // KNC-YYYYMMDD-001
  outletId         String
  createdById      String // Kasir pembuat tiket
  customerId       String?
  vehicleId        String?
  licensePlate     String // Redundan untuk pencarian kilat
  vehicleCategory  VehicleCategory
  servicePackageId String
  servicePrice     Decimal         @db.Decimal(10, 2)
  membershipId             String?
  washClubSubscriptionId   String?
  isMembershipWash         Boolean         @default(false)

  status           TicketStatus @default(QUEUED)
  initialNotes     String? // Catatan kondisi: "Baret spion kiri"
  inspectionPhotos Json? // Array of S3 URLs foto sebelum cuci

  // Waktu Alur Kerja (SLA Metrics)
  queuedAt         DateTime  @default(now())
  washingStartedAt DateTime?
  dryingStartedAt  DateTime?
  readyAt          DateTime?
  completedAt      DateTime?

  // Kalkulasi Finansial
  subtotalServices Decimal       @default(0) @db.Decimal(10, 2)
  subtotalRetail   Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal       @default(0) @db.Decimal(10, 2)
  surchargeAmount  Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal       @db.Decimal(10, 2)
  paidAmount       Decimal       @default(0) @db.Decimal(10, 2)
  cogsAmount       Decimal       @default(0) @db.Decimal(10, 2) // Total HPP modal bahan kimia cuci
  paymentStatus    PaymentStatus @default(UNPAID)

  // Otorisasi Void / Pembatalan
  voidReason       String?       // "HUJAN_DERAS", "ANTREAN_TERLALU_LAMA", "SALAH_INPUT_KASIR", dll.
  voidedAt         DateTime?
  voidedById       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi
  outlet         Outlet               @relation(fields: [outletId], references: [id], onDelete: Cascade)
  creator        User                 @relation("TicketCreator", fields: [createdById], references: [id])
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle        Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  servicePackage ServicePackage       @relation(fields: [servicePackageId], references: [id])
  washers        TicketWasher[]
  retailItems    TicketRetailItem[]
  payment        Payment?
  membership             CustomerMembership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  washClubSubscription   WashClubSubscription? @relation(fields: [washClubSubscriptionId], references: [id], onDelete: SetNull)
  loyaltyLogs            CustomerLoyaltyLog[]
  whatsAppLogs           WhatsAppLog[]
  voidedBy               User?                 @relation("VoidAuthorizer", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([outletId, status])
  @@index([licensePlate])
  @@index([washClubSubscriptionId])
  @@index([createdAt])
}

model TicketWasher {
  id               String    @id @default(cuid())
  ticketId         String
  employeeId       String
  commissionAmount Decimal   @db.Decimal(10, 2)
  assignedAt       DateTime  @default(now())
  isPaidToWasher   Boolean   @default(false)
  paidAt           DateTime?

  // Relasi
  ticket WashTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  washer Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([ticketId, employeeId])
  @@index([employeeId, isPaidToWasher])
}

// -------------------------------------------------------------
// 5. INVENTARIS: RITEL & BAHAN OPERASIONAL
// -------------------------------------------------------------

model RetailProduct {
  id            String   @id @default(cuid())
  outletId      String
  sku           String?
  name          String // Kopi Dingin, Parfum Mobil Kaleng, Snack
  category      String // Minuman, Makanan, Aksesoris
  costPrice     Decimal  @db.Decimal(10, 2)
  sellingPrice  Decimal  @db.Decimal(10, 2)
  stock         Int      @default(0)
  minStockAlert Int      @default(5)
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relasi
  outlet         Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ticketItems    TicketRetailItem[]
  stockMovements StockMovement[]

  @@index([outletId, isActive])
}

model TicketRetailItem {
  id              String  @id @default(cuid())
  ticketId        String
  retailProductId String
  quantity        Int     @default(1)
  unitPrice       Decimal @db.Decimal(10, 2)
  subtotal        Decimal @db.Decimal(10, 2)

  // Relasi
  ticket  WashTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  product RetailProduct @relation(fields: [retailProductId], references: [id])

  @@index([ticketId])
}

model OperationalSupply {
  id                String   @id @default(cuid())
  outletId          String
  sku               String?
  name              String // Shampo Salju Konsentrat, Semir Ban, Degreaser
  unit              String // "Liter", "Botol", "Lembar"
  stock             Decimal  @default(0) @db.Decimal(10, 2)
  minStockAlert     Decimal  @default(5) @db.Decimal(10, 2)
  costPerUnit       Decimal? @default(0) @db.Decimal(10, 2) // Harga beli modal per unit
  usagePerCarWash   Decimal  @default(0.1) @db.Decimal(10, 3) // Pemakaian per mobil (0.1 Liter)
  usagePerMotorWash Decimal  @default(0.04) @db.Decimal(10, 3) // Pemakaian per motor (0.04 Liter)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relasi
  outlet         Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  recipeItems    ServiceRecipeItem[]

  @@index([outletId])
}

model StockMovement {
  id                  String       @id @default(cuid())
  outletId            String
  retailProductId     String?
  operationalSupplyId String?
  movementType        MovementType
  quantity            Decimal      @db.Decimal(10, 2)
  balanceAfter        Decimal      @db.Decimal(10, 2)
  referenceNote       String? // "Penjualan Tiket #KNC-001" atau "Restok Toko Jaya"
  createdAt           DateTime     @default(now())

  // Relasi
  outlet            Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  retailProduct     RetailProduct?     @relation(fields: [retailProductId], references: [id], onDelete: SetNull)
  operationalSupply OperationalSupply? @relation(fields: [operationalSupplyId], references: [id], onDelete: SetNull)

  @@index([outletId, createdAt])
}

// -------------------------------------------------------------
// 6. PEMBAYARAN & STRUK
// -------------------------------------------------------------

model Payment {
  id              String        @id @default(cuid())
  ticketId        String        @unique
  outletId        String
  cashierId       String
  method          PaymentMethod
  status          PaymentStatus @default(PAID)
  totalAmount     Decimal       @db.Decimal(10, 2)
  taxAmount       Decimal?      @default(0) @db.Decimal(10, 2)
  surchargeAmount Decimal?      @default(0) @db.Decimal(10, 2)
  cashGiven       Decimal?      @db.Decimal(10, 2)
  changeGiven     Decimal?      @db.Decimal(10, 2)
  referenceNumber String? // Nomor referensi QRIS / Transfer
  proofImageUrl   String? // Bukti transfer di S3 SumoPod
  paidAt          DateTime      @default(now())

  // Relasi
  ticket  WashTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  outlet  Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  cashier User       @relation("CashierPayments", fields: [cashierId], references: [id])

  @@index([outletId, paidAt])
  @@index([cashierId])
}

model CustomerLoyaltyLog {
  id            String   @id @default(cuid())
  customerId    String
  ticketId      String?
  pointsChanged Int // Positif untuk dapat poin, negatif untuk redeem
  balanceAfter  Int
  description   String // "Poin dari Tiket #KNC-001" atau "Redeem Cuci Gratis"
  createdAt     DateTime @default(now())

  // Relasi
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ticket   WashTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
}

model WhatsAppLog {
  id             String                 @id @default(cuid())
  ticketId       String?
  recipientPhone String
  messageType    String // "RECEIPT", "STATUS_READY", "PROMO", "WASH_CLUB_PASS", "CRM_REENGAGEMENT"
  status         WhatsAppDeliveryStatus @default(PENDING)
  payloadJson    Json?
  externalId     String?
  sentAt         DateTime               @default(now())

  // Relasi
  ticket WashTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([recipientPhone])
}

// -------------------------------------------------------------
// 7. AUDIT TRAIL
// -------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  outletId   String?
  actorId    String
  actorRole  String
  action     String // TICKET_CANCELLED, COMMISSION_PAID, PRICE_CHANGED, VOID_PAYMENT
  entityType String // "WashTicket", "Payment", "Employee", "Stock"
  entityId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Relasi
  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
  actor  User    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([outletId, createdAt])
  @@index([actorId])
}

// -------------------------------------------------------------
// 8. LANGGANAN & MEMBERSHIP PELANGGAN
// -------------------------------------------------------------

model CustomerMembership {
  id              String        @id @default(cuid())
  customerId      String
  outletId        String
  planName        String        // Contoh: "Paket Hemat 4x Cuci / Bulan", "VIP Unlimited 1 Bulan"
  price           Decimal       @db.Decimal(10, 2)
  startDate       DateTime      @default(now())
  endDate         DateTime
  status          String        @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  totalQuota      Int           @default(4) // Kuota cuci (misal 4x, atau 999 untuk unlimited)
  remainingQuota  Int           @default(4) // Sisa kuota cuci yang dapat digunakan
  discountPercent Int           @default(0) // Diskon tambahan produk ritel/detailing (misal 10%)
  paymentMethod   PaymentMethod @default(CASH)
  paymentRef      String?       // Nomor referensi QRIS / transfer
  cashierId       String?       // Kasir yang memproses pendaftaran/pembayaran
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relasi
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  outlet      Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  cashier     User?        @relation("CashierMemberships", fields: [cashierId], references: [id], onDelete: SetNull)
  washTickets WashTicket[]

  @@index([customerId, status])
  @@index([outletId, endDate])
  @@index([status])
}

// -------------------------------------------------------------
// 9. JADWAL & SHIFT KERJA KARYAWAN
// -------------------------------------------------------------

model WorkShift {
  id          String   @id @default(cuid())
  outletId    String
  name        String   // "Shift Pagi", "Shift Siang", "Shift Sore"
  startTime   String   // "07:30"
  endTime     String   // "15:30"
  description String?
  color       String?  @default("blue") // blue, emerald, amber, purple
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi
  outlet      Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]

  @@index([outletId, isActive])
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  outletId   String
  shiftId    String
  employeeId String
  date       DateTime @db.Date // Tanggal penugasan shift (YYYY-MM-DD)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relasi
  outlet   Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  shift    WorkShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([outletId, date])
  @@index([shiftId])
}

// -------------------------------------------------------------
// 10. PEMBAYARAN LANGGANAN LISENSI (FLAT RP 50.000 / BULAN)
// -------------------------------------------------------------

model TenantSubscriptionPayment {
  id              String                    @id @default(cuid())
  outletId        String
  amount          Decimal                   @default(50000) @db.Decimal(10, 2)
  periodMonths    Int                       @default(1)
  paymentMethod   SubscriptionPaymentMethod @default(MANUAL_TRANSFER)
  paymentProofUrl String                    @db.Text
  status          SubscriptionPaymentStatus @default(PENDING)
  notes           String?                   @db.Text
  rejectionReason String?                   @db.Text
  createdAt       DateTime                  @default(now())
  verifiedAt      DateTime?
  verifiedBy      String?

  // Relasi
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, status])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 11. MANAJEMEN KAS LACI KASIR (PETTY CASH IN / OUT)
// -------------------------------------------------------------

model CashMovement {
  id         String           @id @default(cuid())
  outletId   String
  cashierId  String
  type       CashMovementType // PAID_IN | PAID_OUT
  category   String           // "OPERASIONAL", "BAHAN_CUCI", "SETOR_BANK", "MODAL_TAMBAHAN", "KONSUMSI", "LAINNYA"
  amount     Decimal          @db.Decimal(10, 2)
  notes      String
  receiptUrl String?          @db.Text
  createdAt  DateTime         @default(now())

  // Relasi
  outlet  Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  cashier User   @relation("CashierCashMovements", fields: [cashierId], references: [id])

  @@index([outletId, createdAt])
  @@index([cashierId, createdAt])
}

// -------------------------------------------------------------
// 12. MESIN DISKON, HAPPY HOUR & PROMOSI
// -------------------------------------------------------------

model PromotionRule {
  id             String       @id @default(cuid())
  outletId       String
  name           String       // Contoh: "Happy Hour Jam Sepi Pagi", "Promo Komunitas"
  code           String?      // Kode voucher unik jika manual (opsional)
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Decimal      @db.Decimal(10, 2) // Nilai diskon (contoh: 20 (%) atau 15000 (Rp))
  minOrderAmount Decimal?     @db.Decimal(10, 2)
  daysOfWeek     Json?        // Array hari aktif: ["MON", "TUE", "WED", "THU"]
  startHour      String?      // "08:00"
  endHour        String?      // "11:00"
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean      @default(true)
  description    String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relasi
  outlet         Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, isActive])
}

// -------------------------------------------------------------
// 13. RESEP BAHAN HABIS PAKAI & KALKULASI HPP (COGS)
// -------------------------------------------------------------

model ServiceRecipeItem {
  id                  String            @id @default(cuid())
  servicePackageId    String
  operationalSupplyId String
  volumeUsage         Decimal           @db.Decimal(10, 3) // Volume pemakaian per cuci (contoh: 0.100 Liter)
  unit                String            // "Liter", "ml", "Botol"

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // Relasi
  servicePackage      ServicePackage    @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)
  operationalSupply   OperationalSupply @relation(fields: [operationalSupplyId], references: [id], onDelete: Cascade)

  @@index([servicePackageId])
  @@index([operationalSupplyId])
}

// -------------------------------------------------------------
// 14. MODEL LANGGANAN UNLIMITED WASH CLUB BULANAN (RECURRING MEMBERSHIP)
// -------------------------------------------------------------

model WashClubSubscription {
  id           String    @id @default(cuid())
  outletId     String
  vehicleId    String
  customerId   String
  planName     String    // Contoh: "Unlimited Wash Club Mobil", "Unlimited Wash Club Motor"
  priceMonthly Decimal   @db.Decimal(10, 2)
  startDate    DateTime  @default(now())
  expiresAt    DateTime
  isActive     Boolean   @default(true)
  qrPassCode   String    @unique // Kode digital pass untuk verifikasi instant di loket
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relasi
  outlet    Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer  Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tickets   WashTicket[]

  @@index([outletId, isActive])
  @@index([vehicleId, isActive])
  @@index([customerId])
}

