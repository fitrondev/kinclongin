# =============================================================
# KINCLONGIN POS WASH — PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="https://kinclongin.com"

# Auth.js Authentication Configuration
AUTH_SECRET="your_32_byte_secret_key_here"
AUTH_URL="https://kinclongin.com"

# SumoPod Managed MySQL Database (Prisma ORM v7)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require&allowPublicKeyRetrieval=true
DATABASE_URL="mysql://kinclongin:StrongPassword123@sumopod-db.internal:3306/kinclongin?sslmode=require"

# SumoPod Object Storage (S3 Protocol for inspection photos & payment receipts)
SUMOPOD_S3_ENDPOINT="https://storage.sumopod.com"
SUMOPOD_S3_ACCESS_KEY_ID="your_access_key"
SUMOPOD_S3_SECRET_ACCESS_KEY="your_secret_key"
SUMOPOD_S3_BUCKET="kinclongin-storage"
SUMOPOD_S3_REGION="id-jkt-1"

# WhatsApp Business Gateway (Digital Receipt & Real-Time Tracking Link)
WHATSAPP_API_URL="https://api.fonnte.com/send"
WHATSAPP_API_TOKEN="your_whatsapp_gateway_token"

# Kinclongin SaaS Flat Subscription (Rp 50.000 / month / outlet)
NEXT_PUBLIC_SUBSCRIPTION_MONTHLY_FEE="50000"
SUPERADMIN_PAYMENT_BANK_NAME="BCA"
SUPERADMIN_PAYMENT_ACCOUNT_NO="1234567890"
SUPERADMIN_PAYMENT_ACCOUNT_NAME="PT KINCLONGIN DIGITAL NUSANTARA"
